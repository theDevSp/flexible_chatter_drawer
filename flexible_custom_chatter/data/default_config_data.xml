<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Create default configuration on module installation -->
        <record id="default_chatter_drawer_config" model="chatter.drawer.config">
            <field name="button_color_primary">#667eea</field>
            <field name="button_color_secondary">#764ba2</field>
            <field name="button_icon_color">#ffffff</field>
            <field name="drawer_background_color">#f8f9fa</field>
            <field name="overlay_color">rgba(0, 0, 0, 0.5)</field>
            <field name="close_button_color">#6c757d</field>
            <field name="close_button_hover_color">#dc3545</field>
        <field name="color_palette">odoo_default</field>
        <field name="send_message_bg_color"></field>
        <field name="send_message_text_color"></field>
        <field name="log_note_bg_color"></field>
        <field name="log_note_text_color"></field>
        <field name="activities_bg_color"></field>
        <field name="activities_text_color"></field>
            <field name="button_size">60</field>
            <field name="button_border_radius">50</field>
            <field name="drawer_width">50</field>
            <field name="drawer_width_mobile">100</field>
            <field name="button_shadow_size">medium</field>
            <field name="button_position">bottom-right</field>
            <field name="button_horizontal_offset">30</field>
            <field name="button_vertical_offset">30</field>
            <field name="drawer_side">right</field>
            <field name="z_index_button">1040</field>
            <field name="z_index_overlay">1045</field>
            <field name="z_index_drawer">1050</field>
            <field name="enable_animations">True</field>
            <field name="enable_pulse_effect">True</field>
            <field name="animation_duration">0.3</field>
            <field name="enable_overlay">True</field>
            <field name="exclude_models">res.users</field>
            <field name="enable_dark_mode">True</field>
            <field name="dark_mode_drawer_bg">#2d3748</field>
            <field name="dark_mode_close_btn_bg">#2d3748</field>
            <field name="button_icon">fa-comments</field>
        </record>
    </data>
</odoo>

